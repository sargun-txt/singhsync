import Foundation
import FirebaseCore

/// Copy to RegionConfig.swift; real regional plists are ignored bundle resources.
struct RegionConfig {
    static let REGION_CANADA = "CA"
    static let REGION_INDIA = "IN"
    static let REGION_US = "US"
    static let sortedCountryNames = Locale.Region.isoRegions.compactMap {
        Locale(identifier: "en").localizedString(forRegionCode: $0.identifier)
    }.sorted()
    static func getOptimalServer(for country: String) -> String { FirebaseRegion.forCountry(country) }
    static func getOptions(for region: String) -> FirebaseOptions? {
        guard region != REGION_CANADA else { return nil }
        guard let expected = FirebaseRegion.projectID(for: region),
              let path = Bundle.main.path(forResource: "GoogleService-Info-\(region)", ofType: "plist"),
              let options = FirebaseOptions(contentsOfFile: path),
              options.projectID == expected,
              options.bundleID == Bundle.main.bundleIdentifier else {
            preconditionFailure("Missing or mismatched regional Firebase configuration")
        }
        return options
    }
}
